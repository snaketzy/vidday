{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    /* 直接由 Node 原生类型擦除执行 .ts，因此导入需带 .ts 扩展名且不产出 JS */
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
