# Vidday 后台服务环境变量
# 用法：复制本文件为 server/.env 后按需修改；修改后需重启服务。
# 该文件只放服务端凭证，绝不进入前端打包产物（见 electron-builder.yml 的 files 白名单）。

# ---------------------------------------------------------------
# 服务端口。前端 VITE_API_BASE_URL 需指向同一地址（默认 8790）
# ---------------------------------------------------------------
PORT=8790

# ---------------------------------------------------------------
# App 级密钥（必填）
# 前端与 Electron 各持一份，经 `x-app-key` 请求头携带。
# 服务端未配置该值时拒绝启动，避免裸奔。
# 生产环境务必改成足够长的随机串，并与前端 VITE_APP_API_KEY 保持一致。
# ---------------------------------------------------------------
APP_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------
# 允许的跨域来源，逗号分隔；`*` 表示不限制（默认）
# 本服务为本地 / 私有部署，仅靠 App 密钥鉴权，故默认可放开
# ---------------------------------------------------------------
CORS_ORIGINS=*

# ---------------------------------------------------------------
# 图片资源（海报 / 剧照 / 影人头像）的公开访问前缀
# 目录约定：{前缀}/{dirId}/poster-w500.jpg，dirId 取 IMDb ID（缺则 lbz{tmdbId}）
# 线上必须为 HTTPS，以规避混合内容拦截
# ---------------------------------------------------------------
MEDIA_ASSETS_BASE_URL=https://media.laybackzzz.com/Assets

# ---------------------------------------------------------------
# MySQL 数据库（必填）
# 与内容管理端共用同一个库；本服务对内容表只读，仅读写用户侧两张表
# ---------------------------------------------------------------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
